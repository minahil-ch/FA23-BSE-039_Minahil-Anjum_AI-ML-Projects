# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Use sqlite for local dev (default) or postgresql for production
DB_ENGINE=sqlite

# PostgreSQL settings (when DB_ENGINE=postgresql)
DB_NAME=ai_dataset_cleaning
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# File uploads
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_LEVEL=INFO
